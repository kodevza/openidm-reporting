{
  "name": "openidm-reporting",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "build": "npm run typecheck && tsc && tsc -p tsconfig.report.json && node build-ui.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.report.json --noEmit && tsc -p tsconfig.ui.json",
    "test": "npm run build && node --test tests/*.test.cjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "esbuild": "0.28.2",
    "eslint": "^10.15.0",
    "globals": "^16.5.0",
    "jquery": "^3.7.1",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0"
  },
  "dependencies": {
    "@tanstack/preact-table": "9.3.1",
    "preact": "10.27.2"
  }
}
